{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/LEARNING.md",
        "$TURBO_ROOT$/docs/**"
      ],
      "outputs": ["dist/**"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/LEARNING.md",
        "$TURBO_ROOT$/docs/**"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/LEARNING.md",
        "$TURBO_ROOT$/docs/**"
      ]
    }
  }
}
