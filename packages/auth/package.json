{
  "name": "@kitto/auth",
  "version": "0.1.0",
  "private": true,
  "description": "Kitto auth for Next.js: magic-link sign-in, Supabase session handling, tenant context and switching, invitations.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.tsx",
    "./server": "./src/server.ts",
    "./proxy": "./src/proxy.ts",
