# Copy to .env.local (apps) and fill in. Never commit real values.
# Local values come from `pnpm exec supabase status` after `pnpm db:start`.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Tenant resolution: "path" (example.com/t/<slug>) or "subdomain" (<slug>.example.com)
NEXT_PUBLIC_TENANT_MODE=path
# Required in subdomain mode, e.g. example.com. Locally use lvh.me:3000 (it and
# every *.lvh.me resolve to 127.0.0.1); browsers won't share cookies on localhost.
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by trusted jobs and payment callbacks; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- M-Pesa (Daraja) --------------------------------------------------------
# mock = no network calls, a fake callback pays a second later (CI, local dev;
# never on a real deployment); sandbox = Safaricom's test API; production = live.
# Unset turns M-Pesa off.
MPESA_ENV=mock
# sandbox / production only (developer.safaricom.co.ke -> My Apps)
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
# 174379 is the shared sandbox paybill; use your own shortcode in production
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
# Public https origin Safaricom can POST callbacks to (a deploy or a tunnel).
# Each request gets its own random callback path, so no shared secret is needed.
# Defaults to NEXT_PUBLIC_SITE_URL.
MPESA_CALLBACK_BASE_URL=http://localhost:3000

# --- Tests ------------------------------------------------------------------
# Mailpit (local Supabase's email catcher) for e2e magic links
MAILPIT_URL=http://127.0.0.1:55324
