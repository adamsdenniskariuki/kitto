# Copy to .env.local (apps) and fill in. Never commit real values.
# Local values come from `pnpm exec supabase status` after `pnpm db:start`.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Tenant resolution: "path" (example.com/t/<slug>) or "subdomain" (<slug>.example.com)
NEXT_PUBLIC_TENANT_MODE=path
# Required in subdomain mode, e.g. example.com (or localhost:3000 locally)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by trusted jobs and payment callbacks; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- M-Pesa (Daraja) --------------------------------------------------------
# mock = no network calls (CI and local dev); sandbox; production
MPESA_ENV=mock
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
# Random secret that forms part of the callback URL path (see docs/SETUP.md)
MPESA_CALLBACK_SECRET=generate-a-long-random-string
